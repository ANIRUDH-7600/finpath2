// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"  // This creates dev.db file in prisma folder
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String?            @unique
  monthly_income      Float              @default(0)
  risk_appetite       Int                @default(3)
  phone               String?
  password_hash       String?
  avatar_url          String?
  auth_provider       String             @default("credentials")
  google_id           String?            @unique
  onboarding_complete Boolean            @default(false)
  created_at          DateTime           @default(now())

  transactions        Transaction[]
  goals               Goal[]
  portfolio_profiles  PortfolioProfile[]
  nudge_logs          NudgeLog[]

  @@map("users")
}

model Transaction {
  id         String   @id @default(cuid())
  user_id    String
  amount     Float
  merchant   String
  category   String
  date       String
  note       String   @default("")
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("transactions")
}

model Goal {
  id                  String   @id @default(cuid())
  user_id             String
  title               String
  target_amount       Float
  current_savings     Float    @default(0)
  deadline_months     Int
  daily_save_required Float?
  narrative           String?
  status              String   @default("active")
  created_at          DateTime @default(now())

  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("goals")
}

model PortfolioProfile {
  id          String   @id @default(cuid())
  user_id     String   @unique
  risk_score  Int?
  allocation  String?   // Stored as JSON string
  instruments String?   // Stored as JSON string
  sip_amount  Float?
  reasoning   String?
  macro_note  String?
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("portfolio_profiles")
}

model NudgeLog {
  id            String   @id @default(cuid())
  user_id       String
  merchant      String?
  amount        Float?
  category      String?
  nudge_message String?
  user_action   String?
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("nudge_log")
}

model SpendingPattern {
  id           String   @id @default(cuid())
  user_id      String
  pattern_type String   // "micro_transactions", "subscription_creep", "late_night", etc.
  amount       Float
  frequency    String
  suggestion   String
  detected_at  DateTime @default(now())
  resolved     Boolean  @default(false)

  @@index([user_id])
  @@map("spending_patterns")
}

model BehavioralInsight {
  id          String   @id @default(cuid())
  user_id     String
  insight_type String  // "leakage", "saving_opportunity", "behavioral_tip"
  message     String
  priority    String   // "high", "medium", "low"
  read        Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([user_id])
  @@map("behavioral_insights")
}